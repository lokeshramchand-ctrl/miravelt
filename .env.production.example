# Miravelt Backend — production environment
#
# Copy to `.env.production` and fill in real values, then run:
#   docker compose -f docker-compose_production.yaml --env-file .env.production up -d --build
#
# Always pass --env-file explicitly. Compose defaults to reading `./.env`,
# which would silently pick up staging's file (or nothing) if you forget
# this flag and run staging/production compose files from the same
# directory. Fill this in from your secret store (CI secret store, vault,
# etc.) at deploy time — never commit the filled-in file.

MONGODB_URI=mongodb://<production-mongo-host>:27017
MONGODB_DB_NAME=miravelt
MONGODB_REQUIRE_TLS=true
MONGODB_VALIDATE_TLS_CERTIFICATE=true

MILVUS_URI=http://<production-milvus-host>:19530

OLLAMA_URI=
OLLAMA_HOSTS=
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3

# Generate with: openssl rand -hex 32 — see docker-compose_production.yaml's
# comments for why these must never fall back to a client-facing value.
MIRAVELT_API_KEY=
ADMIN_API_KEY=
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional — enables response caching, distributed rate limiting, and the
# Celery worker/beat services in docker-compose_production.yaml.
REDIS_URI=
