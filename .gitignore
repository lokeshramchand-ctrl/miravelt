node_modules
package-lock.json
# admin-dashboard is a real Next.js app (unlike the rest of this repo) -
# its lockfile is committed on purpose for reproducible installs.
!admin-dashboard/package-lock.json
.env
# Any per-environment env file (.env.staging, .env.production, etc.) with
# real secrets filled in - but keep the checked-in *.example templates.
.env.*
!.env.example
!.env.staging.example
!.env.production.example
# Ignore version control
.git

# Ignore virtual environments
.venv
env/
venv/

# Ignore caches and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.sqlite3
.coverage
*.pid

# Ignore node modules if present
node_modules/

# Ignore IDE configs
.vscode/
.idea/
