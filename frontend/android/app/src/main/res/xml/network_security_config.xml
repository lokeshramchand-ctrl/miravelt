<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (API 28+) blocks cleartext (HTTP) traffic app-wide by default.
  This app is self-hosted: the operator runs the backend (plus MongoDB,
  Milvus and Ollama) themselves, and Profile > Developer settings lets them
  point the client at that stack over plain HTTP - typically a LAN address
  like http://192.168.1.5:8000/ while the deployed backend is down.

  Android's network security config cannot express IP ranges (no CIDR, no
  wildcards - <domain> matches a hostname or a single literal address), so
  "permit cleartext to private LAN addresses" is not expressible here. The
  only configuration that lets an arbitrary, DHCP-assigned LAN address work
  is permitting cleartext generally, which is what this does.

  The tradeoff, deliberately accepted: the app no longer gets the OS-level
  guarantee that it can never speak plain HTTP. ApiEnvironment.production
  is still an https:// URL and is still the default for every install, so
  in practice cleartext only happens when someone has unlocked Developer
  settings and typed an http:// URL themselves. To restore the strict
  guarantee for shipped builds, delete this file's base-config and move it
  to android/app/src/debug/res/xml/ (a debug-only resource overlay).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
