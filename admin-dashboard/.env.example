# Miravelt Admin Dashboard — local development environment
#
# Copy to `.env.local` and fill in the values: cp .env.example .env.local
# `.env.local` is gitignored and must never be committed.
#
# This app is a BFF (backend-for-frontend): every one of these values is read
# only on the server (src/lib/backend.ts, src/lib/session*.ts, src/proxy.ts)
# and never shipped to the browser. The browser only ever holds an httpOnly,
# encrypted session cookie - never the FastAPI backend's own API keys or
# tokens directly.

# ---------------------------------------------------------------------------
# Backend connection
# ---------------------------------------------------------------------------
# Base URL of the miravelt-backend FastAPI app (see ../app.py). No trailing slash.
BACKEND_URL=http://localhost:8000

# X-Miravelt-API-Key - authenticates this app as a calling client
# (core/security.py::validate_api_key on the backend). Any non-empty string
# works for local dev if the backend's own MIRAVELT_API_KEY is also
# dev-local-api-key-change-me (see ../.env.example).
MIRAVELT_API_KEY=dev-local-api-key-change-me

# X-Miravelt-Admin-Key - gates /admin/* and POST /app/releases on the backend
# (core/security.py::validate_admin_key). Must match the backend's
# ADMIN_API_KEY - that setting is unset by default, so uncomment it there
# first (../.env.example) or every admin call 503s.
MIRAVELT_ADMIN_KEY=dev-local-admin-key-change-me

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Encrypts/signs the session cookie (iron-session). Must be at least 32
# characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-plus-character-string
