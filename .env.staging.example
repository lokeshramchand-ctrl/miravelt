# Auvren Backend — staging environment
#
# Copy to `.env.staging` and fill in real values, then run:
#   docker compose -f docker-compose.staging.yaml --env-file .env.staging up -d --build
#
# Always pass --env-file explicitly. Compose defaults to reading `./.env`,
# which would silently pick up production's file (or nothing) if you forget
# this flag and run staging/production compose files from the same
# directory. Never let this file's values be copied into .env.production —
# staging must run its own MongoDB, Milvus, Redis, AUVREN_API_KEY and
# JWT_SECRET_KEY, isolated from production data and credentials.

MONGODB_URI=mongodb://<staging-mongo-host>:27017
MONGODB_DB_NAME=auvren_staging
MONGODB_REQUIRE_TLS=true
MONGODB_VALIDATE_TLS_CERTIFICATE=true

MILVUS_URI=http://<staging-milvus-host>:19530

# Optional — leave unset if staging doesn't run its own Ollama.
OLLAMA_URI=
OLLAMA_HOSTS=
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3

# Generate distinct values for staging — never reuse production's:
#   openssl rand -hex 32
AUVREN_API_KEY=
ADMIN_API_KEY=
JWT_SECRET_KEY=

LOG_LEVEL=INFO

# Optional — enables response caching, distributed rate limiting, and the
# Celery worker/beat services in docker-compose.staging.yaml. Point at a
# staging-only Redis instance, not production's.
REDIS_URI=
